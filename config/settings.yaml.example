mode: search_only   # search_only | review_before_submit | fully_automatic
dry_run: true
minimum_match_for_auto_apply: 75
minimum_match_for_dashboard: 60
max_applications_per_run: 10
max_applications_per_day: 25
max_failed_applications_per_run: 5
delay_between_applications_seconds: 30
headless: true
published_within_days: 14
hide_already_applied: true
hide_duplicates: true
database_path: data/jobs.db
logs_dir: logs
browser_profile_dir: private/browser_profile
enabled_sources:
  - bundesagentur
  - indeed
  # - linkedin
  # - stepstone
  # - xing
geocoder: nominatim
cover_letter_template: templates/cover_letter.txt
exclude_on_missing_mandatory: false
# Desktop UI
theme: system          # system | light | dark
language: de           # de | en
start_with_windows: false
minimize_to_tray: false
